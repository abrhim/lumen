{
  "name": "lumen",
  "private": false,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "stress:sweep": "node --import tsx scripts/stress-test-data.mjs --phase=integrity",
    "db:start": "npx --yes supabase start && node scripts/local-stack.mjs write",
    "db:stop": "npx --yes supabase stop",
    "db:reset": "npx --yes supabase db reset",
    "db:regen": "node scripts/dump-schema.mjs && node scripts/dump-seed.mjs",
    "verify": "scripts/verify.sh",
    "dev:prod": "scripts/dev-prod.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "tsx": "^4.22.4",
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
